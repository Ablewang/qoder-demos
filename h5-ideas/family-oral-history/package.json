{
  "name": "family-oral-history-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,h5 \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "test": "tsx --test tests/api.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "express": "^5.1.0",
    "music-metadata": "^11.10.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
