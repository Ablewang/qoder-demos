  "readableHtml": "<div>\r\n                            <ul>\r\n    <li><a href=\"#page=eee3aab04ec5daeb2789\">拳套</a> | <a href=\"#page=4604ff508f140a109632\">枪戟</a> | <a href=\"#page=6c14103ab26360a90a04\">利刃</a> | <a href=\"#page=0abe6ceccad74c753902\">弓弩</a> | <a href=\"#page=6d95bf47eb5231d97b4f\">斧锤</a> | <a href=\"#page=8f0f7e0b74c57d60c065\">法器</a> | <a href=\"#page=d1cfab30817245c1085c\">刀剑</a> | <a href=\"#page=65aee77a1ff80bae91f7\">匕首</a> | <a href=\"#page=d350eeffc4baea62aff5\">法宝</a> |</li>\r\n</ul>\r\n<p><img src=\"assets/fde72f9b0523262d7d23.jpg\" alt=\"官方原始图片，未自动识读\" loading=\"lazy\"></p>\r\n<table>\r\n    <tbody>\r\n        <tr>\r\n            <td><strong>一次轮回</strong></td>\r\n            <td><strong>二次轮回</strong></td>\r\n        </tr>\r\n        <tr>\r\n            <td>名称：★★夜雨十年灯·轮回</td>\r\n            <td>\r\n            <p>名称：★★江湖秋月明</p>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td>类型：单剑</td>\r\n            <td>类型：单剑</td>\r\n        </tr>\r\n        <tr>\r\n            <td>品阶：13</td>\r\n            <td>品阶：15</td>\r\n        </tr>\r\n        <tr>\r\n            <td>物理攻击力：725~1087</td>\r\n            <td>物理攻击力：900~1350</td>\r\n        </tr>\r\n        <tr>\r\n            <td>攻击距离：3</td>\r\n            <td>攻击距离：3</td>\r\n        </tr>\r\n        <tr>\r\n            <td>升级效果：物理攻击+28</td>\r\n            <td>升级效果：物理攻击+28</td>\r\n        </tr>\r\n        <tr>\r\n            <td>附加属性：力量+16~17 致命一击+3% 复仇</td>\r\n            <td>必然会出现的附加属性：复仇、血仇、致命一击+3%或致命一击+4%其中之一</td>\r\n        </tr>\r\n        <tr>\r\n            <td>升级需要的武器：★夜雨十年灯或★凤歌楚狂人</td>\r\n            <td>可能出现附加属性： 致命一击+1% 真气+310 生命+350 力量+18~19 敏捷+18~19 体质+18~19 灵力+18~19 攻击等级+1 命中+30% 攻击距离+1 物理攻击上限+106 物理攻击上限+130 攻击等级+2 防御等级+2 致命一击+2% 攻击等级+3</td>\r\n        </tr>\r\n        <tr>\r\n            <td rowspan=\"3\">桃李春风一杯酒，江湖夜雨十年灯。</td>\r\n            <td>新附加属性解释：血仇，被祝福过的复仇之力，更大机率回复自已5%%生命，且使自已物理攻击提升。</td>\r\n        </tr>\r\n        <tr>\r\n            <td>升级需要的武器：★★夜雨十