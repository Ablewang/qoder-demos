  "readableHtml": "\r\n<div>\r\n   <div>\r\n       <div>\r\n             <div>\r\n                    \r\n\t\t\t\t\t<div>\r\n                         <p class=\"source-reference\">嵌入资源：<a href=\"https://event51.wanmei.com/w2i/201007/maoxian/header.htm\" rel=\"noreferrer\">https://event51.wanmei.com/w2i/201007/maoxian/header.htm</a></p>\r\n                     </div>\r\n                     <div>\r\n                         <div>\r\n                            <div>\r\n                              <div>\r\n                                  <div>\r\n                                     <p>\r\n                                        <a href=\"#page=69753a1e89037ce89a9e\"></a>\r\n                                        <a href=\"#page=8716ef0ffd9713a2e50d\"></a>\r\n                                        <a href=\"#page=78cd277893465d3b5c99\"></a>\r\n                                        <a href=\"#page=bb8d8f83beaa947e8748\"></a>\r\n                                        <a href=\"#page=e9e69bb61aec017b44a8\"></a>\r\n                                        <a href=\"#page=661ea43ec21004c38c81\"></a>\r\n                                        <a href=\"http://bbs.w2i.wanmei.com/viewthread.php?tid=1598145\" rel=\"noreferrer\" target=\"_blank\"></a>\r\n                                        <a href=\"#page=05cdabe45948659d0214\"></a>\r\n                                     </p>\r\n                                  </div>\r\n                                 <div>\r\n                                     <div><img src=\"assets/3409143914366d7d4094.jpg\" alt=\"官方原始图片，未自动识读\" loading=\"lazy\"></div>\r\n                                     <div>\r\n                                         <div>\r\n                                           <h2>说明</h2>\r\n                                            <p>　　接得该任务的玩家，只需在2小时内抵达丛林遗迹的终点便能领取到自己的奖励。<br>\r\n                                                            　　奖励主要为经验元神，抵达终点所用的时间越短，奖励越丰厚。\r\n\t\t\t\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t\t\t\t\t<p>\r\n                                              <a href=\"https://event51.wanmei.com/w2i/201007/maoxian/images/js_01.jpg\" rel=\"noreferrer\" target=\"_blank\"><img src=\"assets/2688c43d761c012bfccc.jpg\" alt=\"官方原始图片，未自动识读\" loading=\"lazy\"></a><br>\r\n                                              遗迹指引者\r\n                                           </p>\r\n                                            <h2>任务详细：</h2>\r\n                                            <p>　　<strong>任务名：</strong>踏破丛林遗迹<br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　<strong>NPC：</strong>遗迹指引者<br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　<strong>任务流程：</strong><br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　在丛林遗迹入口处找到NPC遗迹指引者，与其对话接到任务，任务总时限为2小时，只要在2小时内跑到丛林遗迹的终点处即可完成任务，领取奖励。（遗迹终点为曙光大厅左边的小房间）。<br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　任务完成后3分钟内会传送回遗迹两个入口之一处。<br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　30级以上即可领取该任务。<br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　任务的完成奖励按完成时间发放，越快到达终点，得到的奖励越高。<br>\r\n\t\t\t\t\t\t\t\t\t\t\t　　<strong>奖励表如下:</strong>\r\n\t\t\t\t\t\t\t\t\t\t\t<table>\r\n  <tr>\r\n    <td><p><strong>任务名</strong></p></td>\r\n    <td><p><strong>领取NPC</strong></p></td>\r\n    <td><p><strong>领取条件</strong></p></td>\r\n    <td><p><strong>完成方式</strong></p></td>\r\n    <td><p><strong>完成时间（分）</strong></p></td>\r\n    <td><p><strong>经验</strong></p></td>\r\n    <td><p><strong>元神</strong></p></td>\r\n  </tr>\r\n  <tr>\r\n    <td rowspan=\"5\"><p>踏破丛林遗迹</p></td>\r\n    <td rowspan=\"5\"><p>遗迹指引者</p></td>\r\n    <td rowspan=\"5\"><p>30-39</p></td>\r\n    <td rowspan=\"5\"><p>到达最终房间内</p></td>\r\n    <td><p>10 </p></td>\r\n    <td><p>97024 </p></td>\r\n    <td><p>22121 </p></td>\r\n  </tr>\r\n  <tr>\r\n    <td><p>20 </p></td>\r\n    <td><p>77619 </p></td>\r\n    <td><p>17697 </p></td>\r\n  </tr>\r\n  <tr>\r\n    <td><p>40 </p></td>\r\n    <td><p>58214 </p></td>\r\n    <td><p>13273 </p></td>\r\n  </tr>\r\n  <tr>\r\n    <td><p>60 </p></td>\r\n    <td><p>48512 </p></td>\r\n    <td><p>11061 </p></td>\r\n  </tr>\r\n  <tr>\r\n    <td><p>120 </p></td>\r\n    <td><p>29107