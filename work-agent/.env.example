# 复制为 .env 后填写。授权后拿到的 token 存在 macOS 钥匙串（服务名 work-agent），不写入此文件。

PORT=8787
# 工作时间窗口，用于计算每天的专注时段
WORK_START=10:00
WORK_END=19:00

# 飞书：开发者后台 -> 你的应用 -> 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须是应用里已开通的用户身份权限，空格分隔；验证消息能力时再追加 im 相关权限
FEISHU_SCOPES=offline_access calendar:calendar:readonly

# Google：Cloud Console -> 凭据 -> OAuth 客户端 ID（类型：桌面应用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitLab 地址；个人访问令牌在本地页面里填写，存入钥匙串
GITLAB_URL=https://gitlab.example.com

# LiteLLM（OpenAI 兼容接口），例如 https://litellm.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
