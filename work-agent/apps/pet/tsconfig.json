{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "noEmit": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["vite/client"]
  },
  "include": ["src", "test/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
